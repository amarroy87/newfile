{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-demo-amar"
		},
		"ls_db1_adf_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_db1_adf'"
		},
		"ls_db2_adf_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_db2_adf'"
		},
		"ls_db1_adf_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresqldb01.database.windows.net"
		},
		"ls_db1_adf_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azuresqldb1"
		},
		"ls_db1_adf_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azureuser1"
		},
		"ls_db2_adf_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresqldb01.database.windows.net"
		},
		"ls_db2_adf_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azuresqldb2"
		},
		"ls_db2_adf_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azureuser1"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-demo-amar_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_db1_adf_password": {
						"value": "[parameters('ls_db1_adf_password')]"
					},
					"ls_db2_adf_password": {
						"value": "[parameters('ls_db2_adf_password')]"
					},
					"ls_db1_adf_properties_typeProperties_server": {
						"value": "[parameters('ls_db1_adf_properties_typeProperties_server')]"
					},
					"ls_db1_adf_properties_typeProperties_database": {
						"value": "[parameters('ls_db1_adf_properties_typeProperties_database')]"
					},
					"ls_db1_adf_properties_typeProperties_userName": {
						"value": "[parameters('ls_db1_adf_properties_typeProperties_userName')]"
					},
					"ls_db2_adf_properties_typeProperties_server": {
						"value": "[parameters('ls_db2_adf_properties_typeProperties_server')]"
					},
					"ls_db2_adf_properties_typeProperties_database": {
						"value": "[parameters('ls_db2_adf_properties_typeProperties_database')]"
					},
					"ls_db2_adf_properties_typeProperties_userName": {
						"value": "[parameters('ls_db2_adf_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}